rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == "REPLACE_WITH_OWNER_UID";
    }


    match /passwordFingerprints/{docId} {
      allow read, write: if false;
    }

    match /usernames/{docId} {
      allow read, write: if false;
    }

    match /owners/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && !isOwner();
      allow delete: if isOwner();
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() &&
        (request.auth.uid in resource.data.users || isOwner());

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.auth.uid in request.resource.data.users;

      allow update: if signedIn() &&
        (request.auth.uid in resource.data.users || isOwner());

      allow delete: if signedIn() &&
        (request.auth.uid in resource.data.users || isOwner());
    }

    match /privateChats/{chatId} {
      allow read: if signedIn() &&
        (request.auth.uid in resource.data.participantUids || isOwner());

      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantUids;

      allow update: if signedIn() &&
        (request.auth.uid in resource.data.participantUids || isOwner());

      allow delete: if isOwner();

      match /presence/{uid} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUids
          || isOwner()
        );
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUids
          || isOwner()
        );

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUids
          && request.resource.data.senderUid == request.auth.uid;

        allow update, delete: if signedIn() &&
          (resource.data.senderUid == request.auth.uid || isOwner());
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn() &&
        (request.auth.uid in resource.data.memberUids || isOwner());

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.createdByUid &&
        request.auth.uid in request.resource.data.memberUids;

      allow update: if signedIn() &&
        (request.auth.uid in resource.data.memberUids || isOwner());

      allow delete: if signedIn() &&
        (request.auth.uid == resource.data.createdByUid || isOwner());

      match /presence/{uid} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          || isOwner()
        );
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          || isOwner()
        );

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && request.resource.data.senderUid == request.auth.uid;

        allow update, delete: if signedIn() &&
          (resource.data.senderUid == request.auth.uid || isOwner());
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn() || true;
      match /presence/{uid} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if signedIn();
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        isOwner()
      );
      allow create: if signedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        isOwner()
      );
      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
